# Deployment environment: development | staging | production
# In staging/production the backend refuses to start on insecure defaults.
ENVIRONMENT=development
APP_VERSION=0.1.0
# Product image only (ADR 0018): path to the built frontend served by the
# backend (single origin). Leave empty in dev — Vite serves the UI.
FRONTEND_DIST=
# Backups (ADR 0018): directory for nightly database dumps. Empty = disabled.
# The product stack mounts a volume at /backups and enables this.
BACKUP_DIR=
# Update check feed (ADR 0018). Empty = never phones home. Product installs
# point at the release manifest so /api/system/version can report updates.
UPDATE_MANIFEST_URL=

# Database
DATABASE_URL=postgresql+psycopg://pantryos:pantryos@localhost:5432/pantryos

# LAN exposure: browser origins allowed to call the API cross-origin (comma-separated).
# The bundled frontend proxies /api same-origin and needs none of these; add your
# device/host origins to reach the API from another machine over the LAN.
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Frontend (Vite dev server) counterpart, read by frontend/vite.config.ts — NOT a
# backend Settings field: comma-separated hostnames allowed to reach the dev server
# by name over the LAN, or "all" to disable the Host check. (IPs/localhost always OK.)
# VITE_ALLOWED_HOSTS=pantryos.local,kitchen-tablet.local

# Auth (personal mode: AUTH_ENABLED=false skips bearer tokens)
AUTH_ENABLED=true
AUTH_PERSONAL_EMAIL=admin@pantryos.local
AUTH_PERSONAL_PASSWORD=TestPass123!
AUTH_TOKEN_TTL_HOURS=24

# Home Assistant outbound webhook (ADR 0011). Inventory events are POSTed,
# HMAC-signed (when a secret is set), to this URL — typically an HA webhook
# trigger like http://homeassistant:8123/api/webhook/pantryos. These are the
# FALLBACK seed; the admin Integrations screen stores an encrypted override.
HA_WEBHOOK_URL=
HA_WEBHOOK_SECRET=

# Wildstone Home Lab (ADR 0026): Keystone's address and the `pantry` publisher
# token. Wildstone sets these when it installs PantryOS; a separately hosted
# PantryOS is connected from the admin screen instead (its value wins).
WILDSTONE_KEYSTONE_URL=
WILDSTONE_PUBLISHER_TOKEN=
# Where people open PantryOS in a browser, e.g. https://pantry.home.arpa.
# Given to Wildstone when pairing, for the Pantry card on its dashboard.
# Plain http only for household-network hosts; leave empty to not say.
PANTRYOS_PUBLIC_URL=

# Vendor integrations (step 5)
# Kroger Cart API (OUT) — dormant until a self-serve developer key is set.
KROGER_CLIENT_ID=
KROGER_CLIENT_SECRET=
# Cart API (Phase 4) redirect URI, registered in the Kroger dev portal, e.g.
# https://<host>/api/integrations/kroger/oauth/callback (in-app override available).
KROGER_REDIRECT_URI=
# Purchase intake over IMAP (IN, step 5b) — parse order-confirmation emails from
# the family's own mailbox. Dormant until host+username+password are set. Use a
# dedicated app password, not the account's main password. These are the FALLBACK
# seed values; the admin Integrations screen stores an in-app override (encrypted).
IMAP_HOST=
IMAP_PORT=993
IMAP_USERNAME=
IMAP_PASSWORD=
IMAP_MAILBOX=INBOX

# Encryption key for connector credentials saved via the admin Integrations screen
# (ADR 0009). Empty = in-app secret storage is disabled (env-only config still works).
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CONFIG_SECRET_KEY=

# Productization seam (ADR 0012). Both empty = free mode: everything runs
# locally, nothing phones home. Point these at the hosted PantryOS backend to
# enable premium entitlement and OAuth-brokered store integrations without
# shipping any third-party client secrets.
LICENSE_SERVER_URL=
INTEGRATION_BROKER_URL=
# Entitlement token verification keys (ADR 0018): comma-separated urlsafe-b64
# Ed25519 public keys. Produced by cloud/scripts/gen_signing_key.py.
LICENSE_PUBLIC_KEYS=

# USDA FoodData Central barcode lookup (US branded groceries; public-domain).
# Second source after Open Food Facts. Dormant until set — free key at
# https://api.data.gov/signup/
USDA_FDC_API_KEY=

# Spoonacular recipe search — a second provider alongside the always-on,
# keyless TheMealDB. Dormant until set — free key at
# https://spoonacular.com/food-api
SPOONACULAR_API_KEY=
