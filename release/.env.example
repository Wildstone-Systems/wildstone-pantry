# PantryOS tester configuration — copy to `.env` and fill in.
#
#   cp .env.example .env
#
# This file is public-safe: it contains no real credentials. The two secrets
# below are generated by you, on your machine, and never leave it. Keep the
# resulting `.env` — losing POSTGRES_PASSWORD means losing access to your data.

# ---------------------------------------------------------------------------
# Version (required)
# ---------------------------------------------------------------------------
# Pin an exact release. Immutable versions make your install reproducible and
# make rollback a one-line edit. Do not use `stable` or `latest` here.
# This should already be filled in with the version you were given; whoever
# sent you this file will tell you when there is a newer one.
PANTRYOS_VERSION=0.1.0

# ---------------------------------------------------------------------------
# Secrets (required) — generate these once, then never change them
# ---------------------------------------------------------------------------
# Run this ONE command to generate both. It prints two finished lines — paste
# them over the two empty ones below. Works the same on Windows, macOS and
# Linux, and needs nothing installed beyond the Docker you already have:
#
#   docker run --rm python:3.11-slim python -c "import base64,os,secrets;print('POSTGRES_PASSWORD='+secrets.token_hex(24));print('CONFIG_SECRET_KEY='+base64.urlsafe_b64encode(os.urandom(32)).decode())"
#
# The password for your database. Nothing else ever needs to know it.
POSTGRES_PASSWORD=

# Encrypts any integration credentials you later save in the admin screens (an
# email password, a store API key). Changing it makes those unreadable.
CONFIG_SECRET_KEY=

# ---------------------------------------------------------------------------
# Network (optional)
# ---------------------------------------------------------------------------
# Port on this machine. Change it if 8420 is already taken.
PANTRYOS_PORT=8420

# Who can reach PantryOS:
#   0.0.0.0    anything on your local network — phones, tablets, other laptops
#   127.0.0.1  this machine only
# Neither setting exposes PantryOS to the internet.
PANTRYOS_BIND=0.0.0.0

# ---------------------------------------------------------------------------
# Access control (optional)
# ---------------------------------------------------------------------------
# false (default) = kiosk mode: no login screen, anyone who can reach the
#   address above has full access. Fine for a single machine or a trusted
#   home network.
# true = require a login. The in-app first-run wizard is the easier way to
#   turn this on; if you set it here instead, also set a password below or
#   the app will refuse to start rather than run on a known default.
AUTH_ENABLED=false
AUTH_PERSONAL_EMAIL=admin@pantryos.local
AUTH_PERSONAL_PASSWORD=

# ---------------------------------------------------------------------------
# Update checks (optional)
# ---------------------------------------------------------------------------
# Empty (default) = PantryOS makes no unsolicited network calls whatsoever.
# Set this to a release manifest URL to have the app tell you when a newer
# version exists. Only version metadata is fetched; your pantry data is never
# sent anywhere.
UPDATE_MANIFEST_URL=

# ---------------------------------------------------------------------------
# Wildstone Home Lab (optional)
# ---------------------------------------------------------------------------
# Where people open PantryOS in a browser, e.g. https://pantry.home.arpa.
# Given to Wildstone when pairing, for the Pantry card on its dashboard.
# Plain http only for household-network hosts; leave empty to not say.
PANTRYOS_PUBLIC_URL=
